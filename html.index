<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TuRutaAmiga V5.0 🇲🇽</title>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<style>

/* =====================================================
   TU RUTA AMIGA V5.0
   DISEÑO VISUAL
===================================================== */

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family:
    "Segoe UI",
    Arial,
    Helvetica,
    sans-serif;
}

body {
  background: #e8f8f1;
}

#map {
  width: 100%;
  height: 100%;
  background: #dff6ec;
}


/* =====================================================
   COLORES DEL MAPA
===================================================== */

.leaflet-tile {
  filter:
    saturate(1.35)
    contrast(1.03)
    brightness(1.04);
}


/* =====================================================
   PANEL PRINCIPAL
===================================================== */

.search-panel {

  position: absolute;

  z-index: 1000;

  top: 15px;
  left: 15px;

  width: 300px;

  max-height:
    calc(100vh - 30px);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.98),
      rgba(244,255,250,.97)
    );

  border:
    2px solid rgba(22,139,82,.12);

  border-radius: 20px;

  padding: 12px;

  box-shadow:
    0 12px 35px rgba(0,0,0,.20);

  overflow: hidden;

  backdrop-filter:
    blur(12px);
}


/* =====================================================
   ENCABEZADO
===================================================== */

.logo {

  font-size: 21px;

  font-weight: 900;

  background:
    linear-gradient(
      90deg,
      #07843b,
      #00a86b,
      #0099ff
    );

  -webkit-background-clip: text;

  background-clip: text;

  color: transparent;

  letter-spacing: -.4px;
}

.subtitle {

  font-size: 11px;

  color: #64756c;

  margin:
    2px 0 9px;
}


/* =====================================================
   INPUTS
===================================================== */

.search-row {

  display: flex;

  gap: 6px;
}

input[type="text"],
select {

  width: 100%;

  padding: 9px 10px;

  border:
    1px solid #d2e4dc;

  border-radius: 11px;

  outline: none;

  font-size: 13px;

  background: #ffffff;

  color: #26342e;

  transition: .2s;
}

input[type="text"]:focus,
select:focus {

  border-color:
    #00a86b;

  box-shadow:
    0 0 0 3px
    rgba(0,168,107,.10);
}


/* =====================================================
   BOTONES
===================================================== */

button {

  border: none;

  border-radius: 11px;

  padding: 9px 11px;

  font-size: 13px;

  font-weight: 800;

  cursor: pointer;

  transition:
    transform .15s,
    box-shadow .15s,
    filter .15s;
}

button:hover {

  transform:
    translateY(-1px);

  filter:
    brightness(1.04);
}

button:active {

  transform:
    scale(.97);
}

.blue {

  background:
    linear-gradient(
      135deg,
      #087cff,
      #00a4ff
    );

  color: white;

  box-shadow:
    0 4px 12px
    rgba(0,126,255,.25);
}

.green {

  background:
    linear-gradient(
      135deg,
      #008f4c,
      #00b96b
    );

  color: white;

  box-shadow:
    0 4px 12px
    rgba(0,143,76,.22);
}

.gray {

  background:
    linear-gradient(
      135deg,
      #f1f5f3,
      #e5eee9
    );

  color: #263a31;

  border:
    1px solid #d7e4de;
}

.red {

  background:
    linear-gradient(
      135deg,
      #e53935,
      #ff5c52
    );

  color: white;

  box-shadow:
    0 4px 12px
    rgba(229,57,53,.22);
}

.full {
  width: 100%;
}


/* =====================================================
   ESTADO
===================================================== */

.status {

  font-size: 11px;

  color: #65766e;

  margin:
    7px 2px;
}


/* =====================================================
   GPS
===================================================== */

.gps-activate {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 6px;

  width: 100%;

  margin-bottom: 7px;

  background:
    linear-gradient(
      135deg,
      #007bff,
      #00b8ff
    );

  color: white;

  box-shadow:
    0 5px 14px
    rgba(0,135,255,.25);
}

.gps-activate.loading {

  opacity: .7;

  pointer-events: none;
}

.gps-info {

  display: none;

  padding: 7px;

  margin-bottom: 7px;

  border-radius: 9px;

  font-size: 10px;

  background:
    linear-gradient(
      135deg,
      #edf8ff,
      #e8f5ff
    );

  color: #3d6887;

  border:
    1px solid #cfeaff;
}

.gps-info.show {

  display: block;
}

.gps-info.error {

  background:
    #fff0ee;

  color:
    #a33a2d;

  border-color:
    #ffd0ca;
}


/* =====================================================
   RESULTADOS
===================================================== */

#results {

  max-height: 155px;

  overflow-y: auto;

  margin-top: 6px;

  scrollbar-width: thin;
}

.result {

  padding: 8px;

  margin-bottom: 5px;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #f7fbf9,
      #eef8f3
    );

  border:
    1px solid #dfede6;

  cursor: pointer;

  font-size: 12px;

  transition: .15s;
}

.result:hover {

  background:
    linear-gradient(
      135deg,
      #e4f8ed,
      #e2f5ff
    );

  border-color:
    #9eddbd;

  transform:
    translateX(2px);
}

.result-title {

  font-weight: 800;

  color: #174d35;
}

.result-address {

  color: #75847d;

  font-size: 10px;

  margin-top: 2px;
}


/* =====================================================
   RUTA
===================================================== */

.route-title {

  margin-top: 9px;

  margin-bottom: 6px;

  font-size: 13px;

  font-weight: 900;

  color: #234238;
}

.route-input {

  margin-bottom: 5px;
}

.route-summary {

  display: none;

  margin-top: 7px;

  padding: 9px;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #e8faef,
      #e8f8ff
    );

  border:
    1px solid #c6e9d5;

  font-size: 11px;

  color: #426257;
}

.route-summary strong {

  color: #008f4c;
}


/* =====================================================
   PANEL NAVEGACIÓN
===================================================== */

#navigationPanel {

  position: absolute;

  z-index: 2000;

  top: 15px;

  right: 15px;

  width: 330px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.98),
      rgba(244,251,255,.98)
    );

  border:
    2px solid rgba(0,123,255,.10);

  border-radius: 20px;

  padding: 13px;

  box-shadow:
    0 12px 35px rgba(0,0,0,.22);

  display: none;

  backdrop-filter:
    blur(12px);
}

.navigation-main {

  text-align: center;
}

.maneuver-arrow {

  font-size: 52px;

  line-height: 1;

  margin-bottom: 3px;

  filter:
    drop-shadow(
      0 3px 4px
      rgba(0,0,0,.15)
    );
}

.next-distance {

  font-size: 21px;

  font-weight: 900;

  color:
    #007cff;
}

.street-name {

  font-size: 16px;

  font-weight: 900;

  color: #263d34;

  margin-top: 3px;
}

.instruction {

  font-size: 12px;

  color: #61726b;

  margin-top: 4px;
}

.after {

  margin-top: 9px;

  padding: 8px;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #f2f5f7,
      #eef7f2
    );

  font-size: 11px;

  color: #66756f;

  border:
    1px solid #e1ebe6;
}

.nav-distance {

  margin-top: 9px;

  font-size: 12px;

  font-weight: 800;

  color: #334c42;
}

.gps-status {

  margin-top: 7px;

  padding: 8px;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #edf7ff,
      #eafaff
    );

  color: #3e6880;

  font-size: 11px;

  border:
    1px solid #cfe7f4;
}


/* =====================================================
   MENÚ DE VOZ
===================================================== */

.voice-menu {

  position: fixed;

  z-index: 5000;

  top: 75px;

  right: 360px;

  width: 290px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f3fbf7
    );

  border:
    2px solid rgba(0,168,107,.12);

  border-radius: 17px;

  padding: 13px;

  box-shadow:
    0 12px 35px rgba(0,0,0,.27);

  display: none;
}

.voice-menu.active {

  display: block;
}

.voice-title {

  font-size: 15px;

  font-weight: 900;

  color: #174d35;

  margin-bottom: 11px;
}

.voice-row {

  display: flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 8px;
}

.voice-row label {

  width: 62px;

  flex-shrink: 0;

  font-size: 11px;

  color: #596b63;
}

.voice-row select {

  flex: 1;
}

.voice-row input[type="range"] {

  flex: 1;

  accent-color:
    #00a86b;
}

.voice-status {

  text-align: center;

  font-size: 10px;

  color: #718079;

  margin-top: 7px;
}


/* =====================================================
   MARCADOR GPS
===================================================== */

.location-marker {

  width: 18px;

  height: 18px;

  background:
    #078cff;

  border:
    4px solid white;

  border-radius: 50%;

  box-shadow:
    0 0 0 2px #078cff,
    0 2px 8px rgba(0,0,0,.35);
}


/* =====================================================
   BOTÓN GPS DEL MAPA
===================================================== */

.leaflet-control button {

  border: none;

  cursor: pointer;
}


/* =====================================================
   RUTA EN EL MAPA
===================================================== */

.leaflet-interactive {

  transition:
    opacity .2s;
}


/* =====================================================
   MÓVIL
===================================================== */

@media (max-width:700px) {

  .search-panel {

    top: 10px;

    left: 10px;

    width: 280px;

    max-width:
      calc(100vw - 20px);

    max-height:
      calc(100vh - 20px);

    padding: 10px;

    border-radius: 17px;
  }

  .logo {

    font-size: 18px;
  }

  #results {

    max-height: 130px;
  }

  #navigationPanel {

    left: 10px;

    right: 10px;

    bottom: 10px;

    top: auto;

    width: auto;

    padding: 10px;

    border-radius: 17px;
  }

  .maneuver-arrow {

    font-size: 42px;
  }

  .next-distance {

    font-size: 18px;
  }

  .voice-menu {

    left: 10px;

    right: 10px;

    bottom: 10px;

    top: auto;

    width: auto;
  }
}

</style>
</head>


<body>

<div id="map"></div>


<!-- =====================================================
     PANEL PRINCIPAL
===================================================== -->

<div class="search-panel">

  <div class="logo">
    🗺️ TuRutaAmiga 🇲🇽
  </div>

  <div class="subtitle">
    Navegación para México · V5.0
  </div>


  <button
    id="activateLocationButton"
    class="gps-activate"
    onclick="activateLocation()"
  >
    📍 Activar ubicación
  </button>


  <div
    id="gpsInfo"
    class="gps-info"
  >
    📡 Preparando ubicación...
  </div>


  <div class="search-row">

    <input
      id="searchInput"
      type="text"
      placeholder="Buscar lugar o calle..."
      autocomplete="off"
    >

    <button
      class="blue"
      onclick="searchPlace()"
    >
      🔎
    </button>

  </div>


  <div
    id="searchStatus"
    class="status"
  >
    Escribe un lugar para buscar.
  </div>


  <div id="results"></div>


  <div class="route-title">
    🚗 Cómo llegar
  </div>


  <div class="route-input">

    <input
      id="originInput"
      type="text"
      placeholder="Punto de partida"
    >

  </div>


  <button
    class="gray full"
    style="margin-bottom:5px"
    onclick="useMyLocationAsOrigin()"
  >
    📍 Usar mi ubicación
  </button>


  <div class="route-input">

    <input
      id="destinationInput"
      type="text"
      placeholder="Destino"
    >

  </div>


  <button
    class="green full"
    onclick="calculateRoute()"
  >
    🚗 Calcular ruta
  </button>


  <div
    id="routeSummary"
    class="route-summary"
  ></div>


  <button
    id="startNavigationButton"
    class="blue full"
    style="display:none;margin-top:6px"
    onclick="startNavigation()"
  >
    ▶️ Iniciar ruta
  </button>

</div>


<!-- =====================================================
     PANEL NAVEGACIÓN
===================================================== -->

<div id="navigationPanel">

  <div class="navigation-main">

    <div
      id="maneuverArrow"
      class="maneuver-arrow"
    >
      ↑
    </div>


    <div
      id="nextDistance"
      class="next-distance"
    >
      Preparando...
    </div>


    <div
      id="streetName"
      class="street-name"
    >
      Preparando navegación
    </div>


    <div
      id="instructionText"
      class="instruction"
    >
      Sigue la ruta.
    </div>


    <div
      id="afterInstruction"
      class="after"
    >
      Después: continúa por la ruta.
    </div>


    <div
      id="navDistance"
      class="nav-distance"
    >
      Distancia al destino: calculando...
    </div>


    <div
      id="gpsStatus"
      class="gps-status"
    >
      📡 GPS esperando...
    </div>

  </div>


  <button
    class="gray full"
    style="margin-top:9px"
    onclick="toggleVoiceMenu()"
  >
    ⚙️ Voz
  </button>


  <button
    class="red full"
    style="margin-top:6px"
    onclick="stopNavigation()"
  >
    ⏹️ Detener navegación
  </button>

</div>


<!-- =====================================================
     MENÚ VOZ FLOTANTE
===================================================== -->

<div
  id="voiceMenu"
  class="voice-menu"
>

  <div class="voice-title">
    🎙️ Voz de navegación
  </div>


  <div class="voice-row">

    <label>
      Voz
    </label>

    <select id="voiceSelect"></select>

  </div>


  <div class="voice-row">

    <label>
      Velocidad
    </label>

    <input
      id="voiceRate"
      type="range"
      min="0.7"
      max="1.2"
      step="0.05"
      value="0.95"
    >

  </div>


  <div class="voice-row">

    <label>
      Volumen
    </label>

    <input
      id="voiceVolume"
      type="range"
      min="0"
      max="1"
      step="0.05"
      value="1"
    >

  </div>


  <button
    class="blue full"
    onclick="testVoice()"
  >
    🔊 Probar voz
  </button>


  <button
    id="voiceToggleButton"
    class="gray full"
    style="margin-top:6px"
    onclick="toggleVoice()"
  >
    🔊 Voz ON
  </button>


  <div
    id="voiceStatus"
    class="voice-status"
  >
    Preparando voces...
  </div>

</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


<script>

/* =====================================================
   MAPA
===================================================== */

const mexicoBounds = [
  [14.0, -118.5],
  [33.2, -86.0]
];


const map = L.map(
  "map",
  {
    minZoom: 4,
    maxZoom: 19
  }
).setView(
  [23.6345, -102.5528],
  5
);


L.tileLayer(
  "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
  {
    maxZoom: 19,
    attribution:
      "&copy; OpenStreetMap contributors"
  }
).addTo(map);


map.setMaxBounds(
  mexicoBounds
);


/* =====================================================
   VARIABLES
===================================================== */

let searchMarkers = [];

let currentLocationMarker = null;

let currentAccuracyCircle = null;

let routeLine = null;

let originMarker = null;

let destinationMarker = null;

let routeData = null;

let navigationWatchId = null;

let navigationActive = false;

let currentPosition = null;

let voices = [];

let selectedVoice = null;

let voiceEnabled = true;

let lastSpokenInstruction = "";

let lastSpokenDistance = 999999;


const femaleKeywords = [

  "female",
  "woman",
  "mujer",
  "sabina",
  "paulina",
  "monica",
  "mónica",
  "luciana",
  "helena",
  "elena",
  "carmen",
  "sofia",
  "sofía",
  "zira"

];


/* =====================================================
   INTERFAZ
===================================================== */

function setStatus(text) {

  document.getElementById(
    "searchStatus"
  ).textContent = text;

}


function setGpsStatus(text) {

  const element =
    document.getElementById(
      "gpsStatus"
    );

  if (element) {

    element.textContent = text;

  }

}


function showGpsInfo(
  text,
  isError = false
) {

  const info =
    document.getElementById(
      "gpsInfo"
    );

  info.textContent = text;

  info.classList.add(
    "show"
  );

  if (isError) {

    info.classList.add(
      "error"
    );

  } else {

    info.classList.remove(
      "error"
    );

  }

}


function setGpsButtonLoading(
  loading
) {

  const button =
    document.getElementById(
      "activateLocationButton"
    );

  if (loading) {

    button.classList.add(
      "loading"
    );

    button.textContent =
      "📡 Buscando ubicación...";

  } else {

    button.classList.remove(
      "loading"
    );

    button.textContent =
      "📍 Activar ubicación";

  }

}


function clearSearchMarkers() {

  searchMarkers.forEach(
    marker =>
      map.removeLayer(marker)
  );

  searchMarkers = [];

}


function escapeHtml(text) {

  return String(text)

    .replaceAll("&", "&amp;")

    .replaceAll("<", "&lt;")

    .replaceAll(">", "&gt;")

    .replaceAll('"', "&quot;")

    .replaceAll("'", "&#039;");

}


/* =====================================================
   BÚSQUEDA
===================================================== */

async function searchPlace() {

  const query =
    document.getElementById(
      "searchInput"
    ).value.trim();


  if (!query) {

    setStatus(
      "Escribe un lugar o calle."
    );

    return;

  }


  setStatus(
    "🔎 Buscando en México..."
  );


  clearSearchMarkers();


  document.getElementById(
    "results"
  ).innerHTML = "";


  try {

    const url =
      "https://nominatim.openstreetmap.org/search?" +

      new URLSearchParams({

        q: query,

        format: "json",

        addressdetails: "1",

        limit: "8",

        countrycodes: "mx",

        bounded: "1",

        viewbox:
          "-118.5,33.2,-86.0,14.0"

      });


    const response =
      await fetch(url);


    if (!response.ok) {

      throw new Error(
        "Error de búsqueda"
      );

    }


    const data =
      await response.json();


    displaySearchResults(
      data
    );

  }

  catch (error) {

    console.error(
      "Búsqueda:",
      error
    );

    setStatus(
      "❌ No se pudo realizar la búsqueda."
    );

  }

}


function displaySearchResults(
  data
) {

  const results =
    document.getElementById(
      "results"
    );


  results.innerHTML = "";


  if (!data.length) {

    setStatus(
      "No encontramos resultados en México."
    );

    return;

  }


  setStatus(
    data.length +
    " resultado(s) encontrados"
  );


  data.forEach(
    place => {

      const lat =
        parseFloat(place.lat);

      const lon =
        parseFloat(place.lon);


      const marker =
        L.marker([
          lat,
          lon
        ])
        .addTo(map);


      marker.bindPopup(

        "<b>" +

        escapeHtml(
          place.display_name
            .split(",")[0]
        ) +

        "</b><br>" +

        escapeHtml(
          place.display_name
        )

      );


      searchMarkers.push(
        marker
      );


      const div =
        document.createElement(
          "div"
        );


      div.className =
        "result";


      div.innerHTML = `

        <div class="result-title">
          ${escapeHtml(
            place.display_name
              .split(",")[0]
          )}
        </div>

        <div class="result-address">
          ${escapeHtml(
            place.display_name
          )}
        </div>

      `;


      div.onclick =
        () => {

          map.setView(
            [lat, lon],
            16
          );


          marker.openPopup();


          document.getElementById(
            "destinationInput"
          ).value =
            place.display_name;


          document.getElementById(
            "searchInput"
          ).value =
            place.display_name
              .split(",")[0];

        };


      results.appendChild(
        div
      );

    }
  );

}


/* =====================================================
   GEOCODIFICACIÓN
===================================================== */

async function geocode(
  query
) {

  const url =
    "https://nominatim.openstreetmap.org/search?" +

    new URLSearchParams({

      q: query,

      format: "json",

      limit: "1",

      countrycodes: "mx",

      bounded: "1",

      viewbox:
        "-118.5,33.2,-86.0,14.0"

    });


  const response =
    await fetch(url);


  if (!response.ok) {

    throw new Error(
      "No se pudo consultar el mapa."
    );

  }


  const data =
    await response.json();


  if (!data.length) {

    throw new Error(
      "Lugar no encontrado."
    );

  }


  return {

    lat:
      parseFloat(
        data[0].lat
      ),

    lon:
      parseFloat(
        data[0].lon
      ),

    name:
      data[0].display_name

  };

}


/* =====================================================
   GPS - ENTORNO
===================================================== */

function checkGpsEnvironment() {

  if (
    !navigator.geolocation
  ) {

    return {

      ok: false,

      message:
        "Tu navegador no permite geolocalización."

    };

  }


  if (
    location.protocol ===
      "file:"
  ) {

    return {

      ok: false,

      message:
        "Abre TuRutaAmiga mediante localhost/Live Server o HTTPS."

    };

  }


  if (
    window.top !==
      window.self
  ) {

    return {

      ok: false,

      message:
        "La página está dentro de un marco y podría tener bloqueada la ubicación."

    };

  }


  return {
    ok: true
  };

}


/* =====================================================
   PERMISO GPS
===================================================== */

async function checkGpsPermission() {

  if (
    !navigator.permissions
  ) {

    return "unknown";

  }


  try {

    const permission =
      await navigator.permissions.query({

        name:
          "geolocation"

      });


    return permission.state;

  }

  catch (error) {

    console.warn(
      "Permiso GPS:",
      error
    );

    return "unknown";

  }

}


/* =====================================================
   ACTIVAR GPS
===================================================== */

async function activateLocation() {

  const environment =
    checkGpsEnvironment();


  if (!environment.ok) {

    showGpsInfo(
      "⚠️ " +
      environment.message,
      true
    );


    setStatus(
      environment.message
    );


    return;

  }


  setGpsButtonLoading(
    true
  );


  showGpsInfo(
    "🔐 Comprobando permisos..."
  );


  const permission =
    await checkGpsPermission();


  if (
    permission ===
      "denied"
  ) {

    showGpsInfo(

      "🚫 Chrome tiene bloqueada la ubicación para esta página. Actívala en los permisos del sitio.",

      true

    );


    setStatus(
      "🚫 Ubicación bloqueada por el navegador."
    );


    setGpsButtonLoading(
      false
    );


    return;

  }


  requestLocation(

    position => {

      setGpsButtonLoading(
        false
      );


      updateCurrentLocation(
        position
      );


      map.setView(

        [
          position.coords.latitude,

          position.coords.longitude

        ],

        16

      );


      const accuracy =
        Math.round(
          position.coords.accuracy
        );


      showGpsInfo(

        "📍 Ubicación activa · precisión aproximada ±" +
        accuracy +
        " m"

      );


      setStatus(
        "📍 Ubicación encontrada."
      );

    },

    "ubicación"

  );

}


/* =====================================================
   SOLICITAR GPS
===================================================== */

function requestLocation(
  successCallback,
  context
) {

  const environment =
    checkGpsEnvironment();


  if (!environment.ok) {

    handleGpsEnvironmentError(
      environment.message,
      context
    );

    return;

  }


  setGpsStatus(
    "📡 Buscando ubicación precisa..."
  );


  showGpsInfo(
    "📡 Buscando ubicación..."
  );


  navigator.geolocation.getCurrentPosition(

    position => {

      setGpsButtonLoading(
        false
      );


      successCallback(
        position
      );

    },


    firstError => {

      console.warn(
        "GPS primer intento:",
        firstError.code,
        firstError.message
      );


      if (
        firstError.code === 1
      ) {

        handleGpsError(
          firstError,
          context
        );


        setGpsButtonLoading(
          false
        );


        return;

      }


      setGpsStatus(
        "📡 Intentando ubicación alternativa..."
      );


      showGpsInfo(
        "📡 Intentando ubicación alternativa..."
      );


      navigator.geolocation.getCurrentPosition(

        position => {

          setGpsButtonLoading(
            false
          );


          successCallback(
            position
          );

        },


        secondError => {

          handleGpsError(
            secondError,
            context
          );


          setGpsButtonLoading(
            false
          );

        },


        {

          enableHighAccuracy:
            false,

          timeout:
            30000,

          maximumAge:
            60000

        }

      );

    },


    {

      enableHighAccuracy:
        true,

      timeout:
        30000,

      maximumAge:
        5000

    }

  );

}


/* =====================================================
   ERRORES GPS
===================================================== */

function handleGpsEnvironmentError(
  message,
  context
) {

  console.error(
    "GPS ENTORNO:",
    context,
    message
  );


  showGpsInfo(
    "⚠️ " + message,
    true
  );


  setGpsStatus(
    "⚠️ " + message
  );


  setStatus(
    "⚠️ " + message
  );

}


function handleGpsError(
  error,
  context
) {

  const code =
    error &&
    typeof error.code !==
      "undefined"

      ? error.code

      : 0;


  let text = "";


  if (
    code === 1
  ) {

    text =
      "🚫 Ubicación bloqueada por el navegador. Activa el permiso de ubicación para esta página.";

  }

  else if (
    code === 2
  ) {

    text =
      "📡 No se pudo determinar tu ubicación. Comprueba tu señal GPS o conexión.";

  }

  else if (
    code === 3
  ) {

    text =
      "⏱️ El GPS tardó demasiado en responder. Inténtalo nuevamente.";

  }

  else {

    text =
      "❌ Error de ubicación.";

  }


  console.error(
    "GPS ERROR:",
    context,
    code,
    error?.message
  );


  showGpsInfo(
    text,
    true
  );


  setGpsStatus(
    text
  );


  setStatus(
    text
  );

}


/* =====================================================
   ACTUALIZAR UBICACIÓN
===================================================== */

function updateCurrentLocation(
  position
) {

  const lat =
    position.coords.latitude;


  const lon =
    position.coords.longitude;


  const accuracy =
    position.coords.accuracy;


  currentPosition = {

    lat,
    lon,
    accuracy

  };


  if (
    currentLocationMarker
  ) {

    map.removeLayer(
      currentLocationMarker
    );

  }


  if (
    currentAccuracyCircle
  ) {

    map.removeLayer(
      currentAccuracyCircle
    );

  }


  const icon =
    L.divIcon({

      className: "",

      html:
        '<div class="location-marker"></div>',

      iconSize:
        [18,18],

      iconAnchor:
        [9,9]

    });


  currentLocationMarker =
    L.marker(

      [lat, lon],

      {
        icon
      }

    )

    .addTo(map)

    .bindPopup(
      "📍 Tu ubicación"
    );


  currentAccuracyCircle =
    L.circle(

      [lat, lon],

      {

        radius:
          accuracy,

        color:
          "#078cff",

        fillColor:
          "#33b5ff",

        fillOpacity:
          .10,

        weight:
          2

      }

    ).addTo(map);

}


/* =====================================================
   ORIGEN = MI UBICACIÓN
===================================================== */

function useMyLocationAsOrigin() {

  requestLocation(

    position => {

      updateCurrentLocation(
        position
      );


      const lat =
        position.coords.latitude;


      const lon =
        position.coords.longitude;


      const input =
        document.getElementById(
          "originInput"
        );


      input.value =
        "Mi ubicación";


      input.dataset.lat =
        lat;


      input.dataset.lon =
        lon;


      setStatus(
        "📍 Usando tu ubicación como origen."
      );

    },

    "origen"

  );

}


/* =====================================================
   CALCULAR RUTA
===================================================== */

async function calculateRoute() {

  const originInput =
    document.getElementById(
      "originInput"
    );


  const destinationInput =
    document.getElementById(
      "destinationInput"
    );


  const originText =
    originInput.value.trim();


  const destinationText =
    destinationInput.value.trim();


  if (!originText) {

    alert(
      "Escribe el punto de partida."
    );

    return;

  }


  if (!destinationText) {

    alert(
      "Escribe el destino."
    );

    return;

  }


  setStatus(
    "🚗 Calculando ruta..."
  );


  try {

    let origin;


    if (

      originText ===
        "Mi ubicación" &&

      originInput.dataset.lat

    ) {

      origin = {

        lat:
          parseFloat(
            originInput.dataset.lat
          ),

        lon:
          parseFloat(
            originInput.dataset.lon
          )

      };

    }

    else {

      origin =
        await geocode(
          originText
        );

    }


    const destination =
      await geocode(
        destinationText
      );


    const url =
      "https://router.project-osrm.org/route/v1/driving/" +

      origin.lon +
      "," +
      origin.lat +

      ";" +

      destination.lon +
      "," +
      destination.lat +

      "?overview=full&geometries=geojson&steps=true";


    const response =
      await fetch(url);


    if (!response.ok) {

      throw new Error(
        "Error del servidor de rutas."
      );

    }


    const data =
      await response.json();


    if (

      data.code !== "Ok" ||

      !data.routes ||

      !data.routes.length

    ) {

      throw new Error(
        "No se encontró una ruta."
      );

    }


    routeData =
      data.routes[0];


    drawRoute(
      routeData,
      origin,
      destination
    );


    setStatus(
      "✅ Ruta calculada."
    );

  }

  catch (error) {

    console.error(
      "Ruta:",
      error
    );


    setStatus(
      "❌ No se pudo calcular la ruta."
    );


    alert(
      "No se pudo calcular la ruta."
    );

  }

}


/* =====================================================
   DIBUJAR RUTA
===================================================== */

function drawRoute(
  route,
  origin,
  destination
) {

  if (routeLine) {

    map.removeLayer(
      routeLine
    );

  }


  if (originMarker) {

    map.removeLayer(
      originMarker
    );

  }


  if (destinationMarker) {

    map.removeLayer(
      destinationMarker
    );

  }


  const coordinates =
    route.geometry.coordinates.map(

      coord => [

        coord[1],
        coord[0]

      ]

    );


  routeLine =
    L.polyline(

      coordinates,

      {

        color:
          "#007cff",

        weight:
          8,

        opacity:
          .95,

        lineCap:
          "round",

        lineJoin:
          "round"

      }

    ).addTo(map);


  originMarker =
    L.marker([

      origin.lat,
      origin.lon

    ])

    .addTo(map)

    .bindPopup(
      "🟢 Punto de partida"
    );


  destinationMarker =
    L.marker([

      destination.lat,
      destination.lon

    ])

    .addTo(map)

    .bindPopup(
      "🔴 Destino"
    );


  map.fitBounds(

    routeLine.getBounds(),

    {
      padding:
        [40,40]
    }

  );


  const km =
    route.distance /
    1000;


  const minutes =
    Math.round(
      route.duration /
      60
    );


  const summary =
    document.getElementById(
      "routeSummary"
    );


  summary.innerHTML =

    "<strong>✨ Ruta lista</strong><br>" +

    "📏 " +
    km.toFixed(1) +
    " km<br>" +

    "⏱️ Aproximadamente " +
    formatTime(minutes);


  summary.style.display =
    "block";


  document.getElementById(
    "startNavigationButton"
  ).style.display =
    "block";

}


/* =====================================================
   TIEMPO
===================================================== */

function formatTime(
  minutes
) {

  if (
    minutes < 60
  ) {

    return minutes +
      " min";

  }


  const hours =
    Math.floor(
      minutes / 60
    );


  const mins =
    minutes % 60;


  if (
    mins === 0
  ) {

    return hours +
      " h";

  }


  return hours +
    " h " +
    mins +
    " min";

}


/* =====================================================
   INICIAR NAVEGACIÓN
===================================================== */

function startNavigation() {

  if (!routeData) {

    alert(
      "Primero calcula una ruta."
    );

    return;

  }


  requestLocation(

    position => {

      navigationActive =
        true;


      updateCurrentLocation(
        position
      );


      document.getElementById(
        "navigationPanel"
      ).style.display =
        "block";


      setGpsStatus(

        "📡 GPS conectado · ±" +

        Math.round(
          position.coords.accuracy
        ) +

        " m"

      );


      updateNavigation(
        position
      );


      speak(
        "Iniciando ruta."
      );


      startGpsTracking();

    },

    "inicio de navegación"

  );

}


/* =====================================================
   SEGUIMIENTO GPS
===================================================== */

function startGpsTracking() {

  if (
    navigationWatchId !== null
  ) {

    navigator.geolocation.clearWatch(
      navigationWatchId
    );

    navigationWatchId =
      null;

  }


  navigationWatchId =
    navigator.geolocation.watchPosition(

      position => {

        if (
          !navigationActive
        ) {

          return;

        }


        updateCurrentLocation(
          position
        );


        setGpsStatus(

          "📡 GPS conectado · ±" +

          Math.round(
            position.coords.accuracy
          ) +

          " m"

        );


        updateNavigation(
          position
        );

      },


      error => {

        handleGpsError(
          error,
          "navegación"
        );

      },


      {

        enableHighAccuracy:
          true,

        timeout:
          30000,

        maximumAge:
          2000

      }

    );

}


/* =====================================================
   NAVEGACIÓN
===================================================== */

function updateNavigation(
  position
) {

  if (
    !routeData ||
    !navigationActive
  ) {

    return;

  }


  const destination =
    routeData.geometry
      .coordinates[
        routeData.geometry.coordinates.length - 1
      ];


  const destinationLat =
    destination[1];


  const destinationLon =
    destination[0];


  const distance =
    distanceBetween(

      position.coords.latitude,

      position.coords.longitude,

      destinationLat,

      destinationLon

    );


  document.getElementById(
    "navDistance"
  ).textContent =

    "Distancia al destino: " +

    formatDistance(
      distance
    );


  const steps =
    routeData.legs?.[0]?.steps || [];


  if (steps.length) {

    const step =
      findNextStep(
        position,
        steps
      );


    if (step) {

      updateStep(
        step
      );

    }

  }


  if (
    distance <= 40
  ) {

    arrive();

  }

}


/* =====================================================
   SIGUIENTE MANIOBRA
===================================================== */

function findNextStep(
  position,
  steps
) {

  let closest =
    null;


  let closestDistance =
    Infinity;


  for (
    let i = 0;
    i < steps.length;
    i++
  ) {

    const step =
      steps[i];


    const location =
      step.maneuver?.location;


    if (!location) {

      continue;

    }


    const distance =
      distanceBetween(

        position.coords.latitude,

        position.coords.longitude,

        location[1],

        location[0]

      );


    if (
      distance < closestDistance
    ) {

      closestDistance =
        distance;


      closest =
        step;

    }

  }


  if (!closest) {

    return null;

  }


  closest.distanceToManeuver =
    closestDistance;


  return closest;

}


/* =====================================================
   PASO
===================================================== */

function updateStep(
  step
) {

  const maneuver =
    step.maneuver || {};


  const type =
    maneuver.type || "";


  const modifier =
    maneuver.modifier || "";


  const street =
    maneuver.name ||
    "la siguiente calle";


  const distance =
    step.distanceToManeuver;


  document.getElementById(
    "maneuverArrow"
  ).textContent =

    maneuverArrow(
      type,
      modifier
    );


  document.getElementById(
    "nextDistance"
  ).textContent =

    formatDistance(
      distance
    );


  document.getElementById(
    "streetName"
  ).textContent =
    street;


  const instruction =
    makeInstruction(
      type,
      modifier,
      street
    );


  document.getElementById(
    "instructionText"
  ).textContent =
    instruction;


  if (

    distance < 350 &&

    distance > 20

  ) {

    const rounded =
      Math.round(
        distance / 10
      ) * 10;


    const phrase =

      "En " +

      rounded +

      " metros, " +

      instruction;


    if (

      phrase !==
        lastSpokenInstruction ||

      Math.abs(
        distance -
        lastSpokenDistance
      ) > 80

    ) {

      speak(
        phrase
      );


      lastSpokenInstruction =
        phrase;


      lastSpokenDistance =
        distance;

    }

  }


  const allSteps =
    routeData.legs?.[0]?.steps || [];


  const index =
    allSteps.indexOf(
      step
    );


  const next =
    allSteps[
      index + 1
    ];


  if (next) {

    const nextStreet =
      next.maneuver?.name ||
      "la siguiente calle";


    document.getElementById(
      "afterInstruction"
    ).textContent =

      "Después: " +

      makeInstruction(

        next.maneuver?.type || "",

        next.maneuver?.modifier || "",

        nextStreet

      );

  }

}


/* =====================================================
   FLECHAS
===================================================== */

function maneuverArrow(
  type,
  modifier
) {

  if (
    type === "arrive"
  ) {

    return "🏁";

  }


  if (
    type === "depart"
  ) {

    return "⬆️";

  }


  if (

    modifier === "left" ||

    modifier === "sharp left" ||

    modifier === "slight left"

  ) {

    return "⬅️";

  }


  if (

    modifier === "right" ||

    modifier === "sharp right" ||

    modifier === "slight right"

  ) {

    return "➡️";

  }


  if (
    modifier === "uturn"
  ) {

    return "↩️";

  }


  if (
    type === "roundabout"
  ) {

    return "🔄";

  }


  return "⬆️";

}


/* =====================================================
   INSTRUCCIÓN
===================================================== */

function makeInstruction(
  type,
  modifier,
  street
) {

  if (
    type === "arrive"
  ) {

    return "Has llegado a tu destino.";

  }


  if (
    type === "depart"
  ) {

    return "Continúa por la ruta.";

  }


  if (
    type === "roundabout"
  ) {

    return "Entra a la glorieta.";

  }


  if (
    modifier.includes("left")
  ) {

    return (
      "gira a la izquierda en " +
      street
    );

  }


  if (
    modifier.includes("right")
  ) {

    return (
      "gira a la derecha en " +
      street
    );

  }


  return (
    "continúa por " +
    street
  );

}


/* =====================================================
   DISTANCIA
===================================================== */

function distanceBetween(
  lat1,
  lon1,
  lat2,
  lon2
) {

  const R =
    6371000;


  const dLat =
    toRadians(
      lat2 - lat1
    );


  const dLon =
    toRadians(
      lon2 - lon1
    );


  const a =

    Math.sin(
      dLat / 2
    ) ** 2 +

    Math.cos(
      toRadians(lat1)
    ) *

    Math.cos(
      toRadians(lat2)
    ) *

    Math.sin(
      dLon / 2
    ) ** 2;


  const c =

    2 *

    Math.atan2(

      Math.sqrt(a),

      Math.sqrt(
        1 - a
      )

    );


  return R * c;

}


function toRadians(
  value
) {

  return (
    value *
    Math.PI /
    180
  );

}


function formatDistance(
  meters
) {

  if (
    meters < 1000
  ) {

    return (
      Math.round(meters) +
      " m"
    );

  }


  return (
    meters / 1000
  ).toFixed(1) +
  " km";

}


/* =====================================================
   LLEGADA
===================================================== */

function arrive() {

  if (
    !navigationActive
  ) {

    return;

  }


  navigationActive =
    false;


  if (
    navigationWatchId !== null
  ) {

    navigator.geolocation.clearWatch(
      navigationWatchId
    );

    navigationWatchId =
      null;

  }


  speak(
    "Has llegado a tu destino."
  );


  document.getElementById(
    "maneuverArrow"
  ).textContent =
    "🏁";


  document.getElementById(
    "nextDistance"
  ).textContent =
    "Llegaste";


  document.getElementById(
    "streetName"
  ).textContent =
    "Destino";


  document.getElementById(
    "instructionText"
  ).textContent =
    "Has llegado a tu destino.";


  setGpsStatus(
    "🏁 Llegaste a tu destino."
  );

}


/* =====================================================
   DETENER
===================================================== */

function stopNavigation() {

  navigationActive =
    false;


  if (
    navigationWatchId !== null
  ) {

    navigator.geolocation.clearWatch(
      navigationWatchId
    );

    navigationWatchId =
      null;

  }


  document.getElementById(
    "navigationPanel"
  ).style.display =
    "none";


  document.getElementById(
    "voiceMenu"
  ).classList.remove(
    "active"
  );


  if (
    "speechSynthesis" in window
  ) {

    speechSynthesis.cancel();

  }

}


/* =====================================================
   VOCES
===================================================== */

function loadVoices() {

  if (
    !("speechSynthesis" in window)
  ) {

    document.getElementById(
      "voiceStatus"
    ).textContent =
      "Este navegador no soporta voz.";

    return;

  }


  voices =
    speechSynthesis.getVoices();


  const select =
    document.getElementById(
      "voiceSelect"
    );


  if (!select) {

    return;

  }


  select.innerHTML =
    "";


  const spanishVoices =
    voices.filter(

      voice =>

        voice.lang &&

        voice.lang
          .toLowerCase()
          .startsWith("es")

    );


  if (
    !spanishVoices.length
  ) {

    const option =
      document.createElement(
        "option"
      );


    option.textContent =
      "No hay voces en español";


    select.appendChild(
      option
    );


    document.getElementById(
      "voiceStatus"
    ).textContent =
      "No hay voces españolas disponibles.";

    return;

  }


  spanishVoices.forEach(

    (voice, index) => {

      const option =
        document.createElement(
          "option"
        );


      option.value =
        index;


      option.textContent =

        voice.name +

        " (" +

        voice.lang +

        ")";


      select.appendChild(
        option
      );

    }

  );


  let selectedIndex =
    spanishVoices.findIndex(

      voice => {

        const name =
          voice.name.toLowerCase();


        return femaleKeywords.some(

          keyword =>
            name.includes(
              keyword
            )

        );

      }

    );


  if (
    selectedIndex < 0
  ) {

    selectedIndex =
      spanishVoices.findIndex(

        voice =>

          voice.lang
            .toLowerCase() ===
          "es-mx"

      );

  }


  if (
    selectedIndex < 0
  ) {

    selectedIndex =
      0;

  }


  select.value =
    selectedIndex;


  selectedVoice =
    spanishVoices[
      selectedIndex
    ];


  select.onchange =
    () => {

      const index =
        parseInt(
          select.value
        );


      selectedVoice =
        spanishVoices[
          index
        ];

    };


  document.getElementById(
    "voiceStatus"
  ).textContent =
    "Voz lista 🎙️";

}


if (
  "speechSynthesis" in window
) {

  speechSynthesis.onvoiceschanged =
    loadVoices;


  loadVoices();

}


function speak(
  text
) {

  if (
    !voiceEnabled
  ) {

    return;

  }


  if (
    !("speechSynthesis" in window)
  ) {

    return;

  }


  speechSynthesis.cancel();


  const utterance =
    new SpeechSynthesisUtterance(
      text
    );


  utterance.lang =
    selectedVoice?.lang ||
    "es-MX";


  if (
    selectedVoice
  ) {

    utterance.voice =
      selectedVoice;

  }


  utterance.rate =
    parseFloat(

      document.getElementById(
        "voiceRate"
      ).value

    );


  utterance.volume =
    parseFloat(

      document.getElementById(
        "voiceVolume"
      ).value

    );


  speechSynthesis.speak(
    utterance
  );

}


function testVoice() {

  loadVoices();


  speak(
    "Hola. Esta es la voz de TuRutaAmiga. Te acompañaré durante tu recorrido."
  );

}


function toggleVoice() {

  voiceEnabled =
    !voiceEnabled;


  const button =
    document.getElementById(
      "voiceToggleButton"
    );


  if (
    voiceEnabled
  ) {

    button.textContent =
      "🔊 Voz ON";


    document.getElementById(
      "voiceStatus"
    ).textContent =
      "Voz activada 🎙️";

  }

  else {

    button.textContent =
      "🔇 Voz OFF";


    speechSynthesis.cancel();


    document.getElementById(
      "voiceStatus"
    ).textContent =
      "Voz desactivada";

  }

}


/* =====================================================
   MENÚ VOZ
===================================================== */

function toggleVoiceMenu() {

  const menu =
    document.getElementById(
      "voiceMenu"
    );


  menu.classList.toggle(
    "active"
  );


  if (
    menu.classList.contains(
      "active"
    )
  ) {

    loadVoices();

  }

}


/* =====================================================
   CERRAR MENÚ VOZ
===================================================== */

document.addEventListener(

  "click",

  event => {

    const menu =
      document.getElementById(
        "voiceMenu"
      );


    if (
      !menu.classList.contains(
        "active"
      )
    ) {

      return;

    }


    if (
      menu.contains(
        event.target
      )
    ) {

      return;

    }


    if (
      event.target.closest(
        "button"
      )
    ) {

      return;

    }


    menu.classList.remove(
      "active"
    );

  }

);


/* =====================================================
   ENTER
===================================================== */

document.getElementById(
  "searchInput"
).addEventListener(

  "keydown",

  event => {

    if (
      event.key === "Enter"
    ) {

      searchPlace();

    }

  }

);


document.getElementById(
  "destinationInput"
).addEventListener(

  "keydown",

  event => {

    if (
      event.key === "Enter"
    ) {

      calculateRoute();

    }

  }

);


/* =====================================================
   CONTROL GPS DEL MAPA
===================================================== */

const LocateControl =
  L.Control.extend({

    options: {
      position:
        "bottomright"
    },


    onAdd:
      function() {

        const button =
          L.DomUtil.create(
            "button"
          );


        button.innerHTML =
          "📍";


        button.title =
          "Mi ubicación";


        button.style.width =
          "42px";


        button.style.height =
          "42px";


        button.style.background =
          "white";


        button.style.borderRadius =
          "11px";


        button.style.fontSize =
          "20px";


        button.style.boxShadow =
          "0 3px 12px rgba(0,0,0,.25)";


        button.onclick =
          function(event) {

            L.DomEvent.stopPropagation(
              event
            );


            activateLocation();

          };


        return button;

      }

  });


map.addControl(
  new LocateControl()
);


/* =====================================================
   COMPROBACIÓN INICIAL
===================================================== */

window.addEventListener(
  "load",
  async () => {

    const environment =
      checkGpsEnvironment();


    if (!environment.ok) {

      showGpsInfo(

        "⚠️ " +
        environment.message,

        true

      );


      setStatus(
        environment.message
      );


      return;

    }


    const permission =
      await checkGpsPermission();


    if (
      permission ===
        "denied"
    ) {

      showGpsInfo(

        "🚫 La ubicación está bloqueada. Pulsa el icono 🔒 de Chrome y permite Ubicación.",

        true

      );

    }

  }

);

</script>

</body>
</html>
